# === adaptive agent (Adaptive Agent) 专属模式 v4.0 ===
# 来源：v4 系统文档 + 21 轮实验记录 + 18 万条遥测分析
# genus: adaptive_agent
{"id": "RB-SLEEP-ACTION", "type": "pattern", "technique": "TA0005", "name": "sleep-action-sleep alternation", "severity": 3, "match": {"et": "EXEC", "proc_in": ["sleep"], "parent_in": ["bash", "sh"], "uid": "1000", "dt_in": ["DT1"]}, "precision": "category", "context_required": true, "source": "telemetry", "genus": "adaptive_agent", "notes": "adaptive agentstepping rhythm：sleep(DT1)→动作→sleep(DT1)交替。normal users do not insert sleep。context requires uniformity analysis of adjacent commands"}
{"id": "RB-RECON-UNIFORM", "type": "pattern", "technique": "T1082", "name": "均匀reconnaissance sweep", "severity": 3, "match": {"et": "EXEC", "proccat_in": ["recon"], "parent_in": ["bash", "sh"], "uid": "1000"}, "precision": "category", "context_required": true, "source": "telemetry", "genus": "adaptive_agent", "notes": "adaptive agentuniform reconnaissance distribution（ss/ip/ps/ls/find/free/df/uptime 各~3K），normal admin skewed。requires temporal window distribution"}
{"id": "RB-JOURNALCTL-MONITOR", "type": "pattern", "technique": "T1070", "name": "journalctl security log monitoring", "severity": 3, "match": {"et": "EXEC", "proc_in": ["journalctl"], "parent_in": ["bash", "sh"], "uid": "1000"}, "precision": "category", "context_required": true, "source": "manual", "genus": "adaptive_agent", "notes": "adaptive agent morphological trigger：journalctl -u falco monitoring alerts。120s内≥3条→automated transformation。normal users do not periodically query falco logs"}
{"id": "RB-C2-DISGUISE", "type": "pattern", "technique": "T1071.001", "name": "disguised process C2 outbound connection", "severity": 5, "match": {"et": "CONN", "proc_in": ["node", "python3", "go-build", "cargo-watch", "dotnet", "ruby", "java", "graalvm", "docker-credential", "kubectl", "terraform", "ansible-runner"], "dst": "EXT:HIGH"}, "precision": "exact", "context_required": false, "source": "manual", "genus": "adaptive_agent", "notes": "v4 伪装名池outbound connection高端口。这些开发工具在服务器 VM 上不应主动outbound connection。强信号可独立报警"}
{"id": "RB-PRIVESC-SUID-PY", "type": "pattern", "technique": "T1548.001", "name": "SUID python3 提权", "severity": 5, "match": {"et": "EXEC", "proc_in": ["python3", "python"], "uid": "0", "parent_in": ["bash", "sh"]}, "precision": "exact", "context_required": true, "source": "adaptive_exp21", "genus": "adaptive_agent", "notes": " 实证：SUID python3 + os.setuid(0) 绕过 falco。UID:0 + python3 + bash 父进程 = 提权。context 需看是否有 sudo 在链上"}
{"id": "MT-MORPH-TRANSFORM", "type": "sequence", "technique": "T1070.004", "name": "automated transformation sequence", "severity": 5, "sequence": ["ET:EXEC", "PROC:cp", "ARGV:N2P", "PC:TMP", "PARENT:bash", "UID:1000", "DST:NONE", "DT1", "ET:EXEC", "PROC:chmod", "ARGV:N2P", "PC:TMP", "PARENT:bash", "UID:1000", "DST:NONE", "DT0", "ET:EXEC", "PROC:setsid", "ARGV:N1P", "PC:TMP", "PARENT:bash", "UID:1000", "DST:NONE", "DT1", "ET:EXEC", "PROC:rm", "ARGV:N1P", "PC:TMP", "PARENT:bash", "UID:1000", "DST:NONE", "DT4"], "source": "adaptive_doc", "genus": "adaptive_agent", "n_events": 4, "notes": " automated transformation：cp新形态→chmod→setsid拉起→rm旧文件。omits parent termination。正常软件不存在此sequence", "review": "approved", "review_note": "adaptive agent v4 文档+遥测编码"}
{"id": "RB-EXFIL-MEMORY", "type": "sequence", "technique": "T1041", "name": "memory exfiltrationsequence", "severity": 5, "sequence": ["ET:EXEC", "PROC:cat", "ARGV:N1P", "PC:ETC_PASSWD", "PARENT:bash", "UID:1000", "DST:NONE", "DT1", "ET:CONN", "PROC:python3", "ARGV0", "PC:NONE", "PARENT:bash", "UID:1000", "DST:EXT:HIGH", "DT1"], "source": "adaptive_doc", "genus": "adaptive_agent", "n_events": 2, "notes": "+：cat reads sensitive file→python3encrypted POST。不落盘drop-folder。single-pass transmission", "review": "approved", "review_note": "adaptive agent v4 文档+遥测编码"}
{"id": "RB-PERSIST-TIMER", "type": "pattern", "technique": "T1053.006", "name": "systemd timer persistence", "severity": 4, "match": {"et": "EXEC", "proc_in": ["systemctl"], "argv": "N2P", "parent_in": ["bash", "sh"], "uid": "1000"}, "precision": "exact", "context_required": true, "source": "manual", "genus": "adaptive_agent", "notes": "v4 用 systemd timer 替代 at/crontab 偏离码本原型。UID:1000 操纵 systemctl 双参数"}
{"id": "RB-SH-INDIRECT", "type": "pattern", "technique": "T1059.004", "name": "sh -c indirect execution chain", "severity": 2, "match": {"et": "EXEC", "parent_in": ["sh", "bash"], "uid": "1000"}, "precision": "category", "context_required": true, "source": "adaptive_exp16", "genus": "adaptive_agent", "notes": " 实证：所有动作经 sh -c，PARENT 链被 sh 挡住。单独弱信号，需结合命令均匀性+时序"}
