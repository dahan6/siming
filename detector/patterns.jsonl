# schema 见 pattern_db.py 头注释。severity: 1=参考 5=严重
{"id": "P-T1071-shell-highport", "type": "pattern", "technique": "T1071", "name": "shell 高端口outbound connection", "severity": 4, "match": {"et": "CONN", "proccat_in": ["shell"], "dst": "EXT:HIGH"}, "precision": "category", "context_required": true, "source": "manual", "notes": "交互 shell 不应主动outbound connection；context 维度=dst"}
{"id": "P-T1053-cron-write", "type": "pattern", "technique": "T1053.003", "name": "crontab 写入", "severity": 4, "match": {"et": "EXEC", "proccat_in": ["persist"], "parent_in": ["bash", "sh", "python3", "python"]}, "precision": "category", "context_required": true, "source": "manual", "notes": "persistence；父进程为脚本/shell 时权重高"}
{"id": "P-T1543-systemd-enable", "type": "pattern", "technique": "T1543.002", "name": "systemctl 服务操纵", "severity": 4, "match": {"et": "EXEC", "proc_in": ["systemctl"], "argv": "N2P", "parent_in": ["bash", "sh", "python3"]}, "precision": "exact", "context_required": true, "source": "manual", "notes": "enable/START 类双参数调用"}
{"id": "P-T1059-script-shell", "type": "pattern", "technique": "T1059", "name": "脚本解释器拉 shell", "severity": 5, "match": {"et": "EXEC", "proccat_in": ["shell"], "parent_in": ["python3", "python", "node", "perl", "php"]}, "precision": "category", "context_required": true, "source": "manual", "notes": "python -c 反弹 shell 前置；经典植入指纹"}
{"id": "P-T1140-decode-exec", "type": "pattern", "technique": "T1140", "name": "解码工具执行", "severity": 3, "match": {"et": "EXEC", "proccat_in": ["encode"], "parent_in": ["bash", "sh", "python3"]}, "precision": "category", "context_required": true, "source": "manual", "notes": "base64 -d 等；Falco 自定义规则曾命中此类"}
{"id": "P-T1041-nettool-exfil", "type": "pattern", "technique": "T1041", "name": "网络工具脚本化外传", "severity": 4, "match": {"et": "EXEC", "proccat_in": ["nettool"], "proc_not_in": ["ssh"], "parent_in": ["python3", "python", "node"]}, "precision": "category", "context_required": true, "source": "manual", "notes": "scp/curl 被脚本拉起=自动化外传；ssh 排除（本机自动化高频，16%误报的教训）"}
{"id": "P-T1033-recon-script", "type": "pattern", "technique": "T1033", "name": "脚本化侦察", "severity": 3, "match": {"et": "EXEC", "proccat_in": ["recon"], "parent_in": ["python3", "node", "perl", "php"], "dt_in": ["DT0", "DT1"]}, "precision": "category", "context_required": true, "source": "manual", "notes": "侦察工具被脚本密集拉起"}
